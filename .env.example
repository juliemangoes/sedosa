# ---------------------------------------------------------------
# Database
# Leave DATABASE_URL empty for local development: an embedded
# Postgres (PGlite) is stored in ./.data. In production use a real
# Postgres connection string (e.g. Neon, Supabase, Vercel Postgres).
DATABASE_URL=

# Public URL of the site (used in emails, SMS and Stripe redirects)
APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# Owner dashboard (/admin)
ADMIN_PASSWORD=change-me
# Long random string used to sign login sessions and links.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------
# Stripe (deposits + saved card for no-show fees). Optional:
# without it, deposits are collected manually (Cash App / Zelle / cash)
# and marked paid in the dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Email via Resend (https://resend.com). Optional: without it,
# messages are only written to the dashboard's message log.
RESEND_API_KEY=
EMAIL_FROM="Sedosa Beauty Studio <bookings@yourdomain.com>"
# Where new-booking alerts for the owner go
OWNER_EMAIL=

# ---------------------------------------------------------------
# SMS via Twilio. Optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------------------------------------------------------------
# Protects /api/cron/* (Vercel Cron sends it automatically when set)
CRON_SECRET=
